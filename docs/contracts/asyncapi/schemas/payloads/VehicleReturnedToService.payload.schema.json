{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VehicleReturnedToService · payload",
  "description": "Vehículo listo y de vuelta en la calle; telemetry reinicia contadores de uso.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vehicleId",
    "vehicleType",
    "maintenanceOrderId",
    "workPerformed",
    "zoneId",
    "outOfServiceSeconds"
  ],
  "properties": {
    "vehicleId": {
      "$ref": "../common.schema.json#/$defs/vehicleId"
    },
    "vehicleType": {
      "$ref": "../common.schema.json#/$defs/vehicleType"
    },
    "maintenanceOrderId": {
      "type": "string",
      "description": "Orden de mantenimiento",
      "pattern": "^mnt-[a-z0-9-]+$"
    },
    "workPerformed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/maintenanceWork"
      }
    },
    "zoneId": {
      "$ref": "../common.schema.json#/$defs/zoneId"
    },
    "outOfServiceSeconds": {
      "type": "integer",
      "description": "Tiempo total fuera de servicio (para MTTR)",
      "minimum": 0
    }
  }
}
