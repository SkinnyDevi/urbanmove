# Copia este fichero como .env y pon tus propios valores. .env está en .gitignore:
# NUNCA subas contraseñas ni secretos al repositorio (AGENTS.md 8.5).

# Superusuario de PostgreSQL (solo lo usa el script que crea las bases de datos)
POSTGRES_PASSWORD=
# Puerto en tu máquina (cámbialo si ya usas el 5432)
POSTGRES_PORT=5432

# Una contraseña por servicio (ADR-001: cada servicio, su base de datos y su usuario)
ZONES_DB_PASSWORD=

# Secreto con el que identity firma los JWT y los demás servicios los validan.
# Mínimo 32 caracteres. Por ejemplo, genera uno con:  openssl rand -base64 48
JWT_SECRET=
